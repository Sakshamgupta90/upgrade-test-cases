{
  "compilerOptions": {
    "target": "ES3",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2015", "dom"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importsNotUsedAsValues": "remove",
    "suppressImplicitAnyIndexErrors": true,
    "keyofStringsOnly": true,
    "noImplicitUseStrict": false
  },
  "include": ["src"]
}
